def txids_from_checkpoint_second_round_NTM(wildcards):
    chk_output = checkpoints.filter_selected_TxIDs_second_round_NTM.get(
        assembly_code   = wildcards.assembly_code,
        gencode_version = wildcards.gencode_version,
        tss_subset      = wildcards.tss_subset,
        distance        = wildcards.distance,
        minCount_expr   = wildcards.minCount_expr,
        minSamples_expr = wildcards.minSamples_expr
    ).output.ff_selected_TxIDs

    with open(chk_output) as f:
        return [x.strip() for x in f]

def get_txid_unpack_topK_NTM(wildcards):
    txids = txids_from_checkpoint_second_round_NTM(wildcards)
    return expand(
        "resources/CpG_data/top_K/{assembly_code}_v{gencode_version}_{tss_subset}_{distance}_{minCount_expr}_{minSamples_expr}_{TxID}.bed",
        TxID=txids, **wildcards
    )

def get_txid_unpack_RSE_NTM(wildcards):
